{
  "name": "chichi-cat-world",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "vars": { "GAME_RELEASE": "development" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "ai": { "binding": "AI" },
}
