{
  "name": "chichi-cat-world",
  "main": ".generated/worker.mjs",
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "SAVE_VAULT", "class_name": "SaveVault" }],
  },
  "migrations": [
    { "tag": "save-vault-v1", "new_sqlite_classes": ["SaveVault"] },
  ],
}
